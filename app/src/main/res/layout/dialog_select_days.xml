<?xml version="1.0" encoding="utf-8"?>
<!-- the days an alarm repeats on: a checklist, Save (green check) and Cancel (red cross) on the right -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/select_days_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/select_days_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/medium_margin"
            android:paddingBottom="@dimen/medium_margin" />
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/small_margin"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/select_days_save"
            android:layout_width="@dimen/dpad_side_action_size"
            android:layout_height="@dimen/dpad_side_action_size"
            android:contentDescription="@string/save"
            android:focusable="true"
            android:nextFocusUp="@+id/select_days_cancel"
            android:nextFocusDown="@+id/select_days_cancel"
            android:padding="@dimen/dpad_side_action_padding"
            android:src="@drawable/ic_check_vector" />

        <ImageView
            android:id="@+id/select_days_cancel"
            android:layout_width="@dimen/dpad_side_action_size"
            android:layout_height="@dimen/dpad_side_action_size"
            android:layout_marginTop="@dimen/medium_margin"
            android:contentDescription="@string/cancel"
            android:focusable="true"
            android:nextFocusUp="@+id/select_days_save"
            android:nextFocusDown="@+id/select_days_save"
            android:padding="@dimen/dpad_side_action_padding"
            android:src="@drawable/ic_cross_vector" />
    </LinearLayout>
</LinearLayout>
