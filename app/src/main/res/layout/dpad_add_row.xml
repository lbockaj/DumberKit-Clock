<?xml version="1.0" encoding="utf-8"?>
<!-- "+ Add …" row at the end of a list, reached with the down arrow after the last item -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dpad_add_row"
    style="@style/DpadHomeRow">

    <ImageView
        android:id="@+id/dpad_add_row_icon"
        style="@style/DpadHomeRowIcon"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_plus_vector" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/dpad_add_row_label"
        style="@style/DpadHomeRowLabel" />
</LinearLayout>
