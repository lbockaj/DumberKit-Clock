<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/select_time_zones_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- keypad phones: Save (green check) and Cancel (red cross) on the right, right arrow from any row jumps there -->
    <LinearLayout
        android:id="@+id/select_time_zones_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/small_margin"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/select_time_zones_save"
            android:layout_width="@dimen/dpad_side_action_size"
            android:layout_height="@dimen/dpad_side_action_size"
            android:contentDescription="@string/save"
            android:focusable="true"
            android:nextFocusUp="@+id/select_time_zones_cancel"
            android:nextFocusDown="@+id/select_time_zones_cancel"
            android:padding="@dimen/dpad_side_action_padding"
            android:src="@drawable/ic_check_vector" />

        <ImageView
            android:id="@+id/select_time_zones_cancel"
            android:layout_width="@dimen/dpad_side_action_size"
            android:layout_height="@dimen/dpad_side_action_size"
            android:layout_marginTop="@dimen/medium_margin"
            android:contentDescription="@string/cancel"
            android:focusable="true"
            android:nextFocusUp="@+id/select_time_zones_save"
            android:nextFocusDown="@+id/select_time_zones_save"
            android:padding="@dimen/dpad_side_action_padding"
            android:src="@drawable/ic_cross_vector" />
    </LinearLayout>

    <org.fossify.commons.views.MyRecyclerView
        android:id="@+id/select_time_zones_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/select_time_zones_actions"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

</RelativeLayout>
